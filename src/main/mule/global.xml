	<!-- Configuration Properties -->
	<configuration-properties file="config/jira-config.yaml" doc:name="Configuration properties" />
	
	<!-- Secure Properties Configuration -->
	<secure-properties:config name="securePropertiesConfig" file="config/secure-properties.yaml" key="mySecretKey12345" doc:name="Secure Properties Config">
